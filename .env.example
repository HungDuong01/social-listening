# Copy to .env and adjust. All variables are optional - defaults are in app/core/config.py
SC_HOST=127.0.0.1
SC_PORT=8000
SC_LOG_LEVEL=INFO

# Browser
SC_HEADLESS=true
# Empty = Playwright's headless-shell binary; "chromium" = full browser, new headless mode
SC_CHROMIUM_CHANNEL=chromium
# Empty = let the browser report its real identity. Pinning a UA makes the
# UA header disagree with Sec-CH-UA client hints and triggers login challenges.
SC_USER_AGENT=
# Reuse one on-disk browser profile per platform (keeps login trust tokens).
SC_USE_PERSISTENT_PROFILE=true
SC_SLOW_MO_MS=0
SC_NAV_TIMEOUT_MS=45000
SC_LOCALE=vi-VN
SC_TIMEZONE=Asia/Ho_Chi_Minh

# Crawl defaults
SC_DEFAULT_MAX_POSTS=40
SC_DEFAULT_MAX_COMMENTS=0   # 0 = lay toan bo comment
SC_MAX_SCROLLS=60
SC_SCROLL_DELAY_MIN_MS=900
SC_SCROLL_DELAY_MAX_MS=2100
SC_POST_DELAY_MIN_MS=1500
SC_POST_DELAY_MAX_MS=3500
SC_JOB_TIMEOUT_S=3600

# Politeness - requests per minute per platform
SC_RATE_PER_MINUTE=20
