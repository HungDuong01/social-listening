# Template for `docker compose --env-file .env.docker up -d --build`.
#
# Copy this to `.env.docker` and fill in real values. `.env.docker` is
# git-ignored and must stay that way - it holds real secrets, unlike this
# template.
#
#   cp .env.docker.example .env.docker

# --- PostgreSQL (runs as its own container - see docker-compose.yml) ---
POSTGRES_APP_PASSWORD=change-me-to-a-strong-password

# --- VNC (interactive login for Threads/Instagram/Facebook) ---
# Required. The entrypoint refuses to start the VNC bridge without this -
# an unauthenticated VNC session would expose whatever the browser window
# is doing, login forms included, to anyone who can reach the port.
VNC_PASSWORD=change-me-to-a-strong-password

# --- Host port bindings ---
APP_HOST_PORT=8088
NOVNC_HOST_PORT=6080
POSTGRES_HOST_PORT=5434

# --- Crawler tuning (optional - defaults match app/core/config.py) ---
SC_LOG_LEVEL=INFO
SC_LOCALE=vi-VN
SC_TIMEZONE=Asia/Ho_Chi_Minh
SC_DEFAULT_MAX_POSTS=40
SC_DEFAULT_MAX_COMMENTS=0
SC_RATE_PER_MINUTE=20

# --- Production only (docker-compose.prod.yml) - see README 9.6 ---
# The app has no login system of its own, so Caddy gates every request
# behind these shared team credentials before it ever reaches "app".
# DOMAIN=crawler.example.com
# BASIC_AUTH_USER=team
# BASIC_AUTH_HASH=paste the output of: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'a-strong-password'
